# Common host bind. Keep localhost by default and expose through Nginx only when needed.
LOCAL_BIND=127.0.0.1

# Jenkins already uses 127.0.0.1:8080.
JENKINS_PORT=8080

# Planned infra ports.
POSTGRES_PORT=5432
REDIS_PORT=6379
FRONTEND_PORT=3001
BACKEND_PORT=8000
KAFKA_PORT=9092
KAFKA_UI_PORT=8085
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
NODE_EXPORTER_PORT=9100

# MinIO credentials. Change these in infra/compose/.env, not in this example file.
MINIO_ROOT_USER=s207-minio-admin
MINIO_ROOT_PASSWORD=change-this-minio-password

# PostgreSQL credentials. Change these in infra/compose/.env.
POSTGRES_HOST=localhost
POSTGRES_DB=s207_app
POSTGRES_USER=s207_app
POSTGRES_PASSWORD=change-this-postgres-password

# Redis credentials. Change this in infra/compose/.env.
REDIS_HOST=localhost
REDIS_PASSWORD=change-this-redis-password

# Frontend deployment. Keep mock enabled until backend API is ready.
FRONTEND_API_BASE_URL=https://k14s207.p.ssafy.io
FRONTEND_USE_MOCK=true
FRONTEND_IMAGE_TAG=latest

# Backend deployment. Change BACKEND_BASIC_AUTH_PASSWORD in infra/compose/.env.
BACKEND_IMAGE_TAG=latest
BACKEND_SPRING_PROFILES_ACTIVE=dev
BACKEND_BASIC_AUTH_USER=s207-admin
BACKEND_BASIC_AUTH_PASSWORD=change-this-backend-password
BACKEND_JAVA_OPTS=
BACKEND_KAFKA_BOOTSTRAP_SERVERS=kafka:19092
BACKEND_KAFKA_CONSUMER_GROUP_ID=backend-consumer
JWT_SECRET=change-this-jwt-secret-at-least-32-bytes

# Grafana credentials. Change these in infra/compose/.env.
GRAFANA_ADMIN_USER=s207-admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password

# Kafka single-node KRaft cluster id. Do not change after s207-kafka-data is created.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

# Kafka external producer access.
KAFKA_BIND=0.0.0.0
KAFKA_EXTERNAL_HOST=k14s207.p.ssafy.io
